{
  "name": "plugin-lwc",
  "version": "0.1.0",
  "description": "Salesforce CLI plugin for sf-lwc: add, diff, update, and manage open-source LWC components in Salesforce DX",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "messages",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/srinu2003/sf-lwc.git",
    "directory": "packages/plugin-lwc"
  },
  "homepage": "https://srinu2003.github.io/sf-lwc/",
  "bugs": {
    "url": "https://github.com/srinu2003/sf-lwc/issues"
  },
  "keywords": [
    "salesforce",
    "sf-plugin",
    "lwc",
    "sfdx",
    "cli"
  ],
  "oclif": {
    "bin": "sf",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "flexibleTaxonomy": true,
    "topics": {
      "lwc": {
        "description": "manage and install open-source LWC components in Salesforce DX"
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^5.0.0",
    "@salesforce/core": "^9.4.0",
    "@salesforce/sf-plugins-core": "^13.0.0",
    "sf-lwc": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
