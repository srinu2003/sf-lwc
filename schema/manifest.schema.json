{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sf-lwc component manifest",
  "type": "object",
  "required": ["name", "version", "apiVersion", "files"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Registry name; must match the folder name under components/." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "apiVersion": { "type": "string", "pattern": "^\\d+\\.0$", "description": "Minimum Salesforce API version, e.g. \"62.0\"." },
    "dependencies": {
      "type": "array", "items": { "type": "string" },
      "description": "Other registry components to install first."
    },
    "files": {
      "type": "array", "minItems": 1, "items": { "type": "string" },
      "description": "Paths relative to <package-dir>/main/default, e.g. lwc/dataTable/dataTable.js. Source lives in components/<name>/files/<path>."
    },
    "labels": {
      "type": "array",
      "description": "Custom labels merged into labels/CustomLabels.labels-meta.xml (never overwritten).",
      "items": {
        "type": "object",
        "required": ["fullName", "value"],
        "additionalProperties": false,
        "properties": {
          "fullName": { "type": "string" },
          "value": { "type": "string" },
          "shortDescription": { "type": "string" },
          "language": { "type": "string", "default": "en_US" },
          "protected": { "type": "boolean", "default": false }
        }
      }
    },
    "notes": {
      "type": "array", "items": { "type": "string" },
      "description": "Manual steps printed after install (permission sets, objects, fields, etc.)."
    }
  }
}
